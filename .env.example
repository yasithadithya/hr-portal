# Repo-root .env — shared by apps/api and scripts/. Gitignored. Never commit real values.
# Local development: `pnpm dev:setup` fills this from `pnpm supabase start`.

# Control plane: runtime URL (Supabase transaction pooler, port 6543)
CONTROL_DATABASE_URL=
# Control plane: migrations (session pooler or direct, port 5432). Falls back to CONTROL_DATABASE_URL.
CONTROL_DATABASE_DIRECT_URL=
# Control-plane Supabase project URL (platform admins sign in here)
CONTROL_SUPABASE_URL=
# 32 random bytes, base64 (`openssl rand -base64 32`). Encrypts tenant secrets. Back it up!
MASTER_KEY=
PLATFORM_BASE_DOMAIN=hrportal.lk

# Used only by `pnpm tenant:create --existing-project <ref>` (read from env, never CLI args)
TENANT_DB_URL=
TENANT_DB_DIRECT_URL=
TENANT_SUPABASE_URL=
TENANT_ANON_KEY=
TENANT_SERVICE_ROLE_KEY=

# Notes for Supabase URLs:
# - URL-encode special characters in the password (@ -> %40, ! -> %21, # -> %23)
# - `?pgbouncer=true` (a Prisma flag) is stripped automatically

# ── Jobs & notifications (Phase 8) ────────────────────────────────────────────
# pg-boss runs on the control-plane DB. Use a session/direct URL (port 5432), not the 6543 pooler.
JOBS_ENABLED=true
JOBS_DATABASE_URL=
# Daily per-tenant job (reminders, nightly attendance), cron in Asia/Colombo
JOBS_DAILY_CRON=30 1 * * *
# log (dev default: nothing is sent) | smtp | resend
EMAIL_PROVIDER=log
# Local Supabase Mailpit (enable smtp_port in supabase/config.toml): smtp://127.0.0.1:54325
SMTP_URL=
RESEND_API_KEY=
EMAIL_FROM=HR Portal <no-reply@hrportal.lk>
# Links in emails; default https://<tenant primary domain>. Local dev: http://localhost:3000
APP_BASE_URL=
