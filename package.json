{
  "name": "hr-portal",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@hr/api --filter=@hr/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @hr/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @hr/db db:generate",
    "tenants:migrate": "pnpm --filter @hr/scripts exec tsx src/tenants-migrate.ts",
    "tenant:create": "pnpm --filter @hr/scripts exec tsx src/tenant-create.ts",
    "seed:demo": "node -e \"console.log('seed:demo arrives in Phase 10')\"",
    "prepare": "husky",
    "control:migrate": "pnpm --filter @hr/scripts exec tsx src/control-migrate.ts",
    "dev:setup": "pnpm --filter @hr/scripts exec tsx src/dev-setup.ts && pnpm control:migrate && pnpm tenant:create --slug dev --name \"Dev Company\" --admin-email admin@dev.local --existing-project local --region local --domain localhost --resume"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@hr/config": "workspace:*",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "supabase": "^2.121.0",
    "turbo": "^2.11.9",
    "typescript": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
